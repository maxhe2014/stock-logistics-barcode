<odoo>
    <record id="rule_stock_barcodes_picking_recent_own" model="ir.rule">
        <field name="name">Scan Workbench Recent: own records</field>
        <field name="model_id" ref="model_stock_barcodes_picking_recent" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]" />
    </record>
</odoo>
