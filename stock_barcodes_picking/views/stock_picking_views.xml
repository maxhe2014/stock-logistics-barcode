<?xml version="1.0" encoding="utf-8" ?>
<!--
  Add a "Barcode Scan" button to the stock.picking form (header).
-->
<odoo>
    <record id="view_picking_form_inherit_barcode" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.barcode</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_barcode_scan"
                        type="object"
                        string="Barcode Scan"
                        class="oe_highlight"
                        invisible="state not in ('assigned', 'confirmed', 'partially_available')"/>
            </xpath>
        </field>
    </record>
</odoo>
