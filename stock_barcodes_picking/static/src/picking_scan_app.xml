  Template for the PickingScanApp client action (OWL).
  Responsive card-stack layout (design: /home/max/下载/扫码设计).

  Structure:
    - top bar (doc name + progress)
    - scan row (input + camera + back)
    - hint bar (status + active target + force-add offer)
    - from/to strip
    - candidate-picking selector overlay (multi-match)
    - package stacks: one stack per result_package, each holding
      product cards (qty / lot / serial) and a package footer bar
    - footer (progress + action buttons)

  JS hooks kept: .o_picking_scan_moves, [data-scan-row], [data-scan-lot].
-->
<templates id="template" xml:space="preserve">
    <t t-name="stock_barcodes_picking.PickingScanApp">
        <div class="o_picking_scan_app d-flex flex-column h-100">

            <!-- Top bar: source button + transfer name + progress + cog -->
            <div class="o_scan_topbar" t-if="state.picking_id">
                <button type="button" class="o_scan_src_btn" t-on-click="onOpenSourcePicking" title="查看源单据">
                    <img class="o_scan_src_icon" src="/stock_barcodes_picking/static/src/img/top_doc.svg" alt=""/>
                </button>
                <div class="o_scan_doc_wrap">
                    <a
                        class="o_scan_doc o_scan_doc_link"
                        href="#"
                        title="打开拣货单"
                        t-on-click.prevent="onOpenPicking"
                    ><t t-out="state.picking_name" /></a>
                    <div class="o_scan_doc_progress">
                        进度：<t t-out="state.total_done" />/<t t-out="state.total_demand" />
                    </div>
                </div>
                <button
                    type="button"
                    class="o_scan_refresh_btn"
                    title="刷新单据"
                    t-att-disabled="state.scanning or state.pullRefresh === 'refreshing' ? 'disabled' : ''"
                    t-on-click="() => this.onRefreshPicking()"
                >
                    <i
                        t-att-class="'fa fa-refresh' + (state.pullRefresh === 'refreshing' ? ' fa-spin' : '')"
                        aria-hidden="true"
                    />
                </button>
            </div>

            <!-- Scan row: back + input(with barcode icon) + camera (design 23) -->
            <div class="o_scan_scanrow">
                <button
                    type="button"
                    class="o_scan_key o_picking_scan_back"
                    t-on-click="onBack"
                    title="返回">
                    <img class="o_scan_back_icon" src="/stock_barcodes_picking/static/src/img/icon_back.svg" alt=""/>
                    <img
                        class="o_scan_back_icon o_scan_icon_pressed"
                        src="/stock_barcodes_picking/static/src/img/icon_back_blue.svg"
                        alt=""
                    />
                </button>
                <div class="o_scan_input_wrap">
                    <img class="o_scan_barcode_icon" src="/stock_barcodes_picking/static/src/img/icon_barcode.svg" alt=""/>
                    <input
                        type="text"
                        class="o_picking_scan_input"
                        placeholder="扫码或输入条码..."
                        t-att-disabled="state.scanning or isQuantityEditing or state.visible_switch_selector or state.visible_force_add or state.unclaim_choices.length ? 'disabled' : ''"
                        t-on-keydown="onManualScanEnter"
                    />
                    <button
                        type="button"
                        class="o_scan_cam_inline o_picking_scan_camera"
                        t-att-disabled="state.scanning or isQuantityEditing or state.visible_switch_selector or state.visible_force_add or state.unclaim_choices.length ? 'disabled' : ''"
                        t-on-click="onCameraScan"
                        aria-label="扫码"
                        title="扫码"
                    >
                        <img class="o_scan_camera_icon" src="/stock_barcodes_picking/static/src/img/icon_camera.svg" alt=""/>
                    </button>
                </div>
                <CogMenu t-if="state.picking_id" t-props="cogMenuProps"/>
            </div>

            <!-- Hint bar: mode hint / status / active target, one line each -->
            <div t-if="state.message || state.active_move_product_name || state.last_unmatched_barcode || state.scan_mode !== 'default'"
                 t-att-class="'o_scan_hintbar ' + (state.message ? alertClass : '')">
                <div class="o_scan_hint_text">
                    <div
                        class="o_scan_hint_line"
                        t-if="state.scan_mode !== 'default' and state.mode_hint and state.mode_hint != state.message"
                    ><t t-out="state.mode_hint" /></div>
                    <div class="o_scan_hint_line" t-if="state.message">
                        <t t-out="state.message" />
                    </div>
                    <div class="o_scan_hint_line" t-if="state.active_move_product_name">
                        当前操作： <t t-out="state.active_move_product_name" />
                    </div>
                </div>
                <button
                    t-if="state.last_unmatched_barcode"
                    type="button"
                    class="btn btn-sm btn-outline-primary"
                    t-on-click="onForceAddFromBarcode"
                >
                    <i class="fa fa-plus me-1"/>Force add "<t t-out="state.last_unmatched_barcode" />"
                </button>
            </div>

            <!-- Section title -->
            <div class="o_scan_section_title" t-if="state.rows.length">产品</div>

            <!-- Candidate-picking selector overlay (multi-match) -->
            <div t-if="state.visible_switch_selector"
                 class="o_picking_scan_selector p-3 border rounded bg-warning bg-opacity-10">
                <div class="fw-bold mb-2">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    Multiple transfers match — select one:
                </div>
                <div class="list-group">
                    <t t-foreach="state.pending_switch_pickings" t-as="p" t-key="p.id">
                        <button
                            type="button"
                            class="list-group-item list-group-item-action"
                            t-on-click="() => this.onSelectPickingCandidate(p.id)"
                        >
                            <i class="fa fa-file-text-o me-2"/>
                            <t t-out="p.name" />
                        </button>
                    </t>
                </div>
            </div>

            <!-- Cross-order confirm bar -->
            <div class="o_scan_confirm_bar" t-if="state.cross_order_pending">
                <span class="o_scan_confirm_text">该序列号仍被其他单据预留</span>
                <button
                    type="button"
                    class="o_scan_confirm_btn"
                    t-on-click="() => this.onConfirmCrossOrder()"
                >确认拣货</button>
            </div>

            <!-- Pull-to-refresh feedback (touch gesture on the list) -->
            <div
                class="o_scan_pull_indicator"
                t-if="state.pullRefresh !== 'idle'"
                t-att-data-state="state.pullRefresh"
            >
                <i
                    t-att-class="'fa ' + (state.pullRefresh === 'refreshing' ? 'fa-spinner fa-spin' : 'fa-arrow-down')"
                    aria-hidden="true"
                />
                <span t-if="state.pullRefresh === 'refreshing'">刷新中…</span>
                <span t-elif="state.pullRefresh === 'ready'">松开刷新</span>
                <span t-else="">下拉刷新</span>
            </div>

            <!-- Product rows (v4: one card per move, packages on the lot) -->
            <div class="o_picking_scan_rows o_picking_scan_moves">
                <div t-if="!state.rows.length" class="o_scan_empty">
                    <t t-out="this.tr('Scan a transfer name or product to begin.')" />
                </div>
                <t t-foreach="state.rows" t-as="row" t-key="row.row_key">
                    <div
                        t-att-class="'o_scan_row' + (state.active_move_id === row.move_id ? ' is-selected' : '')"
                        t-att-data-scan-row="row.row_key"
                    >
                        <div class="o_scan_row_top">
                            <span>从：<t t-out="row.location_name" /></span>
                            <span>至：<t t-out="row.location_dest_name" /></span>
                            <span class="o_scan_row_demand">需求 <t t-out="row.demand_qty" /></span>
                        </div>
                        <div
                            class="o_scan_row_main"
                            t-on-click="() => this.onSelectMove(row.move_id)"
                        >
                            <div class="o_scan_prod_box">
                                <i class="fa fa-tag" />
                                <span t-out="row.product_name" />
                            </div>
                            <div class="o_scan_side">
                                <div class="o_scan_picked">
                                    <span class="o_scan_picked_label">已拣:</span>
                                    <b
                                        t-att-class="this.isRowComplete(row) ? 'is-done' : ''"
                                        t-out="row.picked_qty"
                                    />
                                    <span class="o_scan_picked_uom" t-out="row.uom_name" />
                                </div>
                                <!-- 数量追溯产品：已拣下方的 修改 / +N -->
                                <div class="o_scan_qty_btns" t-if="row.tracking === 'none'">
                                    <button
                                        t-if="this.quantityEditLot(row)"
                                        type="button"
                                        class="o_scan_lot_edit_btn"
                                        title="修改"
                                        t-on-click.stop="() => this.onOpenLineEditor(this.quantityEditLot(row), row)"
                                    >
                                        <i class="fa fa-pencil" />
                                    </button>
                                    <button
                                        type="button"
                                        class="o_scan_lot_add"
                                        title="增加一个单位"
                                        t-on-click.stop="() => this.onAddMoveQuantity(row.move_id, null, row.package_id)"
                                    >+1</button>
                                </div>
                            </div>
                        </div>
                        <!-- 数量追溯产品：卡片上的包裹号 -->
                        <div
                            class="o_scan_qty_pkg"
                            t-if="row.tracking === 'none' and this.quantityPackages(row)"
                        >
                            <i class="fa fa-cube" />
                            <span t-out="this.quantityPackages(row)" />
                        </div>
                        <div class="o_scan_lots" t-if="row.tracking !== 'none'">
                            <t t-set="head" t-value="this.headerLot(row)" />
                            <!-- 收起态头部：显示当前（最后扫码）批次 -->
                            <div
                                t-if="head"
                                t-att-class="'o_scan_lot_box o_scan_lot_head' + (state.recentScanLotKey === row.row_key + ':' + (head.id or '') ? ' is-scanned' : '')"
                                t-att-data-scan-lot="row.row_key + ':' + (head.id or '')"
                            >
                                <div class="o_scan_lot_select">
                                    <div class="o_scan_lot_info">
                                        <div class="o_scan_lot_line">
                                            <i class="fa fa-barcode" />
                                            <span
                                                class="o_scan_lot_name"
                                                t-out="head.name or '未分配批次'"
                                            />
                                        </div>
                                        <div
                                            class="o_scan_lot_line o_scan_lot_pkg"
                                            t-if="head.package_from or head.package_to"
                                        >
                                            <i class="fa fa-cube" />
                                            <span t-out="head.package_from or '未装包'" />
                                            <t
                                                t-if="head.package_to and head.package_to !== head.package_from"
                                            >
                                                <span class="o_scan_pkg_arrow">›</span>
                                                <span t-out="head.package_to" />
                                            </t>
                                        </div>
                                    </div>
                                    <button
                                        type="button"
                                        class="o_scan_row_toggle"
                                        title="展开/收起批次"
                                        t-on-click.stop="() => this.onToggleRowLots(row.row_key)"
                                    >
                                        <i
                                            t-att-class="'fa ' + (this.isRowExpanded(row) ? 'fa-chevron-up' : 'fa-chevron-down')"
                                        />
                                    </button>
                                </div>
                            </div>
                            <!-- 展开面板：全部批次 -->
                            <div class="o_scan_lots_panel" t-if="this.isRowExpanded(row)">
                                <t
                                    t-foreach="row.lots"
                                    t-as="lot"
                                    t-key="row.row_key + '_p_' + (lot.id or lot.name or 'none') + (lot.picked ? '_p' : '_r')"
                                >
                                    <div
                                        t-att-class="'o_scan_lot_row' + (state.recentScanLotKey === row.row_key + ':' + (lot.id or '') ? ' is-scanned' : '')"
                                        t-att-data-scan-lot="row.row_key + ':' + (lot.id or '')"
                                    >
                                        <div class="o_scan_lot_info">
                                            <div class="o_scan_lot_line">
                                                <i class="fa fa-barcode" />
                                                <span
                                                    class="o_scan_lot_name"
                                                    t-out="lot.name or '未分配批次'"
                                                />
                                            </div>
                                            <div
                                                class="o_scan_lot_line o_scan_lot_pkg"
                                                t-if="lot.package_from or lot.package_to"
                                            >
                                                <i class="fa fa-cube" />
                                                <span t-out="lot.package_from or '未装包'" />
                                                <t
                                                    t-if="lot.package_to and lot.package_to !== lot.package_from"
                                                >
                                                    <span class="o_scan_pkg_arrow">›</span>
                                                    <span t-out="lot.package_to" />
                                                </t>
                                            </div>
                                        </div>
                                        <div class="o_scan_lot_actions">
                                            <span class="o_scan_lot_qty">
                                                已拣: <t t-out="lot.quantity" />
                                            </span>
                                            <button
                                                t-if="lot.show_add"
                                                type="button"
                                                class="o_scan_lot_add"
                                                title="增加一个单位"
                                                t-on-click.stop="() => this.onPickReservedLot(row.move_id, lot.id)"
                                            >+1</button>
                                            <button
                                                t-if="lot.picked and lot.line_ids and lot.line_ids.length"
                                                type="button"
                                                class="o_scan_lot_edit_btn"
                                                title="修改"
                                                t-on-click.stop="() => this.onOpenLineEditor(lot)"
                                            >
                                                <i class="fa fa-pencil" />
                                            </button>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            <div
                                t-if="!head"
                                class="o_scan_lot_box o_scan_lot_empty"
                            >
                                <span>未分配批次</span>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            <!-- Footer -->
            <div class="o_scan_footer">
                <div class="o_scan_footer_progress" t-if="state.picking_id">
                    进度：<t t-out="state.total_done" /> / <t t-out="state.total_demand" />
                </div>
                <div class="o_scan_footer_actions">
                    <button
                        t-if="state.picking_id"
                        type="button"
                        t-att-class="'o_scan_key o_scan_more_btn' + (state.moreMenuOpen ? ' is-open' : '')"
                        t-on-click="() => this.onToggleMoreMenu()"
                    >更多…</button>
                    <div class="o_scan_footer_actions_right">
                        <button
                            t-if="canPutInPack"
                            type="button"
                            class="o_scan_key"
                            t-on-click="() => this.onPutInPack()"
                        >新包裹</button>
                        <button
                            t-if="state.show_put_in_pack"
                            type="button"
                            t-att-class="'o_scan_key' + (state.scan_mode === 'pack' ? ' o_scan_key_intent' : '')"
                            title="Pack the picked products into a package: scan or choose one"
                            t-on-click="() => this.onSetPackIntent()"
                            t-out="this.tr(state.scan_mode === 'pack' ? 'Packing…' : 'Pack')"
                        />
                        <button
                            t-if="canConsumeByDemand"
                            type="button"
                            class="o_scan_key"
                            t-on-click="() => this.onConsumeByDemand()"
                            t-out="this.tr('Consume by demand')"
                        />
                        <button
                            t-if="canConfirm"
                            type="button"
                            class="o_scan_key"
                            t-on-click="() => this.onConfirm()"
                            t-out="this.tr('Confirm')"
                        />
                        <button
                            t-if="state.visible_force_add"
                            type="button"
                            class="o_scan_key o_scan_key_warn"
                            t-on-click="() => this.onConfirmNewProduct()"
                            t-out="this.tr('Add Product and Pick')"
                        />
                        <button
                            t-if="state.visible_force_add"
                            type="button"
                            class="o_scan_key"
                            t-on-click="() => this.onCancelNewProduct()"
                            t-out="this.tr('Cancel')"
                        />
                        <button
                            t-if="state.visible_force_done"
                            type="button"
                            class="o_scan_key o_scan_key_warn"
                            t-on-click="() => this.onForceDone()"
                            t-out="this.tr('Force Consume')"
                        />
                        <button
                            t-if="canValidate"
                            type="button"
                            class="o_scan_key o_scan_key_primary"
                            t-on-click="() => this.onValidatePicking()"
                            t-out="this.tr('Validate')"
                        />
                    </div>
                </div>
            </div>

            <!-- 更多… action sheet -->
            <div class="o_scan_more_menu" t-if="state.moreMenuOpen">
                <button type="button" t-on-click="() => this.onAddProduct()">添加产品</button>
                <button
                    t-if="state.show_put_in_pack"
                    type="button"
                    t-on-click="() => this.onSelectPackage()"
                >选择包裹</button>
                <button
                    t-if="state.show_put_in_pack"
                    type="button"
                    t-on-click="() => this.onOpenSplitDialog()"
                >移除包裹</button>
                <button
                    t-if="state.show_put_in_pack"
                    type="button"
                    t-on-click="() => this.onStartSplitScan()"
                >扫描拆包</button>
                <button
                    t-if="state.show_put_in_pack"
                    type="button"
                    t-on-click="() => this.onStartUnclaimScan()"
                >取消拣货</button>
                <button
                    t-if="state.scan_mode !== 'default'"
                    type="button"
                    t-on-click="() => this.onExitScanMode()"
                >退出当前模式</button>
            </div>

            <!-- Row editor dialog -->
            <div class="o_scan_split_dialog" t-if="state.editLine">
                <div class="o_scan_split_card">
                    <div class="o_scan_split_title">编辑明细</div>
                    <label class="o_scan_edit_row">
                        <span>数量</span>
                        <input type="number" t-model="state.editLine.qty" />
                    </label>
                    <label class="o_scan_edit_row" t-if="!state.editLine.qtyOnly">
                        <span>批次/序列号</span>
                        <input type="text" t-model="state.editLine.lotName" />
                    </label>
                    <label class="o_scan_edit_row">
                        <span>源包</span>
                        <input type="text" t-model="state.editLine.packageFrom" />
                    </label>
                    <label class="o_scan_edit_row">
                        <span>目标包</span>
                        <input type="text" t-model="state.editLine.packageTo" />
                    </label>
                    <div class="o_scan_edit_actions">
                        <button type="button" t-on-click="() => this.onCloseLineEditor()">取消</button>
                        <button type="button" t-on-click="() => this.onSaveLineEditor()">保存</button>
                    </div>
                </div>
            </div>
            <!-- 拆包 dialog -->
            <div class="o_scan_split_dialog" t-if="state.splitDialogOpen">
                <div class="o_scan_split_card">
                    <div class="o_scan_split_title">选择要从本单移除的包裹</div>
                    <div class="o_scan_split_list">
                        <button
                            type="button"
                            t-foreach="state.splitPackages"
                            t-as="pkg"
                            t-key="pkg.id"
                            t-on-click="() => this.onConfirmRemovePackage(pkg.id)"
                        >
                            <span class="o_scan_split_name">
                                <i class="fa fa-archive" /> <t t-out="pkg.name" />
                            </span>
                            <span class="o_scan_split_meta">
                                <t t-out="pkg.line_count" /> 行 · <t t-out="pkg.quantity" />
                            </span>
                        </button>
                        <div t-if="!state.splitPackages.length" class="o_scan_split_empty">
                            本单没有已装包的明细。源包是货物在库位中的实际归属，不会被移除。
                        </div>
                    </div>
                    <button
                        type="button"
                        class="o_scan_split_cancel"
                        t-on-click="() => this.onCloseSplitDialog()"
                    >取消</button>
                </div>
            </div>
            <!-- 取消拣货 / 拆包：该产品分布在多个包裹时，选择要操作的包裹 -->
            <div class="o_scan_split_dialog" t-if="state.unclaim_choices.length">
                <div class="o_scan_split_card">
                    <div class="o_scan_split_title">
                        <t t-if="state.scan_mode === 'split_scan'">拆包：</t>
                        <t t-else="">取消拣货：</t>
                        <t t-out="state.unclaim_product_name" />
                    </div>
                    <div class="o_scan_split_list">
                        <button
                            type="button"
                            t-foreach="state.unclaim_choices"
                            t-as="choice"
                            t-key="choice.package_id or 'loose'"
                            t-on-click="() => this.onSelectUnclaimPackage(choice.package_id)"
                        >
                            <span class="o_scan_split_name">
                                <i class="fa fa-cube" />
                                <t t-out="choice.package_name or '未装包'" />
                            </span>
                            <span class="o_scan_split_meta">
                                <t t-out="state.scan_mode === 'split_scan' ? '已装' : '已拣'" />
                                <t t-out="choice.quantity" />
                            </span>
                        </button>
                    </div>
                    <button
                        type="button"
                        class="o_scan_split_cancel"
                        t-on-click="() => this.onCancelUnclaim()"
                    >取消</button>
                </div>
            </div>
        </div>
    </t>
</templates>
