<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_picking_type_form_inherit_barcode_mrp" model="ir.ui.view">
    <field name="name">stock.picking.type.form.inherit.barcode.mrp</field>
    <field name="model">stock.picking.type</field>
    <field name="inherit_id" ref="stock.view_picking_type_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='general']" position="after">
        <page name="barcode_mrp" string="Barcode"
              invisible="code != 'mrp_operation'">
          <group string="Location Scanning">
            <field name="barcode_scan_source_location"/>
            <field name="barcode_scan_dest_location"/>
          </group>
          <group string="Lot/Serial Numbers">
            <field name="barcode_mrp_lot_scan_policy"/>
            <field name="barcode_show_reserved_sns"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
