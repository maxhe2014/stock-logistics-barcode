  Template for the MrpScanApp client action (OWL).
  Renders a touch-friendly scan flow:
    - manual input box (Enter to submit; also driven by global
      barcode_service keyboard listener)
    - consolidated hint area (status message + active-scan target + qty)
    - MO info strip (production name + finished product + qty)
    - component checklist (per move: name, demand, picked)
    - action buttons (fixed at bottom for shop-floor scanning)
-->
<templates id="template" xml:space="preserve">
    <t t-name="stock_barcodes_mrp.MrpScanApp">
        <div class="o_mrp_scan_app d-flex flex-column h-100">
            <!-- Header: manual scan input + escape-hatch button + back -->
            <div class="o_mrp_scan_header p-3 border-bottom">
                <div class="row g-2 align-items-center">
                    <div class="col">
                        <input
                            type="text"
                            class="form-control form-control-lg o_mrp_scan_input"
                            placeholder="Scan or type barcode…"
                            t-att-disabled="state.scanning ? 'disabled' : ''"
                            t-on-keydown="onManualScanEnter"
                        />
                    </div>
                    <!-- Escape hatch: when the finished SN has not been
                         scanned yet, the operator may have clicked a
                         component row by mistake. This button drops the
                         component context so the next scan matches the
                         finished product SN. -->
                    <div t-if="canBackToFinishedLot" class="col-auto">
                        <button
                            type="button"
                            class="btn btn-outline-primary btn-lg"
                            t-on-click="onBackToFinishedLot">
                            <i class="fa fa-barcode me-1"/>扫成品SN
                        </button>
                    </div>
                    <div class="col-auto">
                        <button
                            type="button"
                            class="btn btn-secondary btn-lg o_mrp_scan_camera"
                            t-att-disabled="state.scanning ? 'disabled' : ''"
                            t-on-click="onCameraScan"
                            aria-label="Scan with camera"
                            title="Scan with camera"
                        >
                            <i class="fa fa-camera" aria-hidden="true"/>
                        </button>
                    </div>
                    <div class="col-auto">
                        <button
                            type="button"
                            class="btn btn-secondary btn-lg o_mrp_scan_header_back"
                            t-on-click="onBack"
                        >Back</button>
                    </div>
                </div>
            </div>

            <!-- Consolidated operational hints: status message +
                 active-scan target merged into one alert box. The quantity
                 input for non-serial components lives inline on the
                 component row (pencil button) instead of here. -->
            <div t-if="state.message || state.active_move_product_name"
                 class="o_mrp_scan_message m-3">
                <div t-att-class="'alert ' + (state.message ? alertClass : 'alert-info') + ' mb-0'">
                    <t t-if="state.message"><t t-out="state.message" /></t>
                    <t t-if="state.message &amp;&amp; state.active_move_product_name"><br/></t>
                    <t t-if="state.active_move_product_name">
                        <span class="text-primary">
                            <i class="fa fa-hand-o-right me-1"/>正在扫描：
                            <t t-out="state.active_move_product_name" />
                        </span>
                    </t>
                </div>
            </div>

            <!-- MO info strip (only when an MO is selected) -->
            <div t-if="state.production_id" class="o_mrp_scan_mo_info m-3 p-2 border rounded">
                <div class="d-flex flex-wrap gap-3">
                    <span><strong>MO:</strong> <t t-out="state.production_name" /></span>
                    <span><strong>Product:</strong> <t t-out="state.production_product_name" /></span>
                    <span t-if="state.location_name"><strong>Location:</strong> <t t-out="state.location_name" /></span>
                    <span><strong>Qty producing:</strong> <t t-out="state.finished_qty_producing" /> / <t t-out="state.production_product_qty" /></span>
                </div>
            </div>

            <!-- Finished SN display + clear button -->
            <div t-if="state.finished_lot_name || state.finished_lot_id"
                 class="o_mrp_scan_finished_sn d-flex align-items-center flex-wrap gap-2 px-3 py-2 bg-light border-bottom">
                <i class="fa fa-barcode text-success"/>
                <span class="text-muted">成品 SN：</span>
                <span class="fw-bold text-break" style="min-width: 0;">
                    <t t-out="state.finished_lot_name" />
                </span>
                <button t-if="canCleanFinishedLot"
                        type="button"
                        class="btn btn-sm btn-outline-danger ms-auto"
                        t-on-click="onCleanFinishedLot">Clear SN</button>
            </div>

            <!-- Component checklist -->
            <div class="o_mrp_scan_components flex-grow-1 overflow-auto p-3">
                <div t-if="!state.components.length" class="text-muted">
                    No components to display. Scan a finished product / MO first.
                </div>
                <table t-else="" class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:2rem"></th>
                            <th>Component</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.components" t-as="comp" t-key="comp.id">
                            <tr
                                t-att-class="!comp.picked ? 'table-danger' : 'table-success'"
                                t-att-style="state.active_move_id === comp.id ? 'border-left:4px solid #0d6efd;' : ''"
                                t-att-data-scan-row="comp.id"
                                t-on-click="() => this.onSelectMove(comp.id)"
                                role="button"
                            >
                                <td class="text-center align-middle">
                                    <i
                                        t-att-class="state.active_move_id === comp.id ? 'fa fa-hand-o-right text-primary' : 'fa fa-hand-o-right text-muted opacity-25'"
                                    />
                                </td>
                                <td class="align-middle">
                                    <!-- Line 1: component name -->
                                    <div><t t-out="comp.product_name" /></div>
                                    <!-- Line 2: qty line (MO form semantics) -->
                                    <div class="small text-muted lh-sm">
                                        待消耗
                                        <t t-out="comp.to_consume" />
                                        /
                                        <t t-out="comp.total_demand" />
                                        <span class="mx-1">·</span>
                                        已消耗
                                        <t t-out="comp.quantity" />
                                    </div>
                                    <!-- Line 3: SN + actions (consume/reset) merged here to
                                         save columns and give the component name full width -->
                                    <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                                        <t t-if="comp.lots.length === 1">
                                            <span t-att-class="'badge d-inline-flex align-items-center gap-1 ' + (comp.lots[0].picked ? 'bg-info' : 'bg-light text-muted border') + (state.recentComponentLotKey === comp.id + ':' + comp.lots[0].key ? ' o_mrp_scan_recent' : '')"
                                                  t-att-data-scan-lot="comp.id + ':' + comp.lots[0].key">
                                                <i class="fa fa-barcode"/>
                                                <span class="small">
                                                    <t t-out="comp.lots[0].name" />
                                                </span>
                                                <strong t-if="comp.lots[0].picked">× <t t-out="comp.lots[0].picked_quantity" /></strong>
                                                <t t-else="">
                                                    <span class="small opacity-75">待消耗</span>
                                                    <strong>× <t t-out="comp.lots[0].reserved_quantity" /></strong>
                                                </t>
                                                <button t-if="comp.lots[0].picked"
                                                        type="button"
                                                        class="btn btn-sm btn-link text-danger p-0"
                                                        t-att-title="'Remove ' + comp.lots[0].name"
                                                        t-on-click.stop="() => this.onRemoveComponentLot(comp.id, comp.lots[0].id)">
                                                    <i class="fa fa-trash"/>
                                                </button>
                                                <t t-if="!comp.lots[0].picked &amp;&amp; state.barcode_mrp_lot_scan_policy === 'optional'">
                                                    <button t-if="comp.tracking === 'serial'"
                                                            type="button"
                                                            class="btn btn-sm btn-outline-success p-0 px-1"
                                                            title="Consume reserved lot"
                                                            t-on-click.stop="() => this.onConsumeReservedLot(comp.id, comp.lots[0].id)">
                                                        <i class="fa fa-check"/>
                                                    </button>
                                                    <t t-else="">
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-success p-0 px-1"
                                                                title="Consume reserved lot"
                                                                t-on-click.stop="() => this.onConsumeReservedLot(comp.id, comp.lots[0].id)">
                                                            +1
                                                        </button>
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-primary p-0 px-1"
                                                                title="Edit quantity"
                                                                t-on-click.stop="() => this.onEditReservedLotQty(comp.id, comp.lots[0].key)">
                                                            <i class="fa fa-pencil"/>
                                                        </button>
                                                    </t>
                                                </t>
                                            </span>
                                            <div t-if="!comp.lots[0].picked &amp;&amp; comp.tracking !== 'serial' &amp;&amp; state.editingReservedLotKey === comp.id + ':' + comp.lots[0].key"
                                                 class="d-flex align-items-center gap-1 border rounded p-2 bg-white text-dark w-100"
                                                 t-on-click.stop="">
                                                <input type="number"
                                                       min="0"
                                                       step="any"
                                                       class="form-control form-control-sm"
                                                       style="width: 6rem;"
                                                       t-att-value="state.draftReservedLotQty"
                                                       t-on-input="(ev) => this.onDraftReservedLotQtyInput(ev)"
                                                       t-on-keydown="(ev) => this.onDraftReservedLotQtyKeydown(ev, comp.id, comp.lots[0].id)"/>
                                                <button type="button"
                                                        class="btn btn-sm btn-success"
                                                        title="Confirm quantity"
                                                        t-on-click.stop="() => this.onConfirmReservedLotQty(comp.id, comp.lots[0].id)">
                                                    <i class="fa fa-check"/>
                                                </button>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        title="Cancel"
                                                        t-on-click.stop="() => this.onCancelReservedLotQty()">
                                                    <i class="fa fa-times"/>
                                                </button>
                                            </div>
                                        </t>
                                        <t t-elif="comp.lots.length > 1">
                                            <span t-att-class="'badge d-inline-flex align-items-center gap-1 ' + (comp.lots[comp.lots.length - 1].picked ? 'bg-info' : 'bg-light text-muted border') + (state.recentComponentLotKey === comp.id + ':' + comp.lots[comp.lots.length - 1].key ? ' o_mrp_scan_recent' : '')"
                                                  t-att-data-scan-lot="comp.id + ':' + comp.lots[comp.lots.length - 1].key">
                                                <i class="fa fa-barcode"/>
                                                <t t-out="comp.lots[comp.lots.length - 1].name" />
                                                <strong t-if="comp.lots[comp.lots.length - 1].picked">× <t t-out="comp.lots[comp.lots.length - 1].picked_quantity" /></strong>
                                                <t t-else="">
                                                    <span class="small opacity-75">待消耗</span>
                                                    <strong>× <t t-out="comp.lots[comp.lots.length - 1].reserved_quantity" /></strong>
                                                </t>
                                            </span>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1"
                                                    t-att-title="state.expandedComponentId === comp.id ? '收起全部' : '展开全部'"
                                                    t-on-click.stop="() => this.onToggleComponentLots(comp.id)">
                                                <i t-att-class="state.expandedComponentId === comp.id ? 'fa fa-caret-up' : 'fa fa-caret-down'"/>
                                                共 <t t-out="comp.lots.length" /> 个
                                            </button>
                                        </t>
                                        <t t-else="">
                                            <!-- Serial component, no SN yet: hint the operator -->
                                            <span t-if="comp.tracking === 'serial' &amp;&amp; !comp.picked"
                                                  class="small text-info d-inline-flex align-items-center gap-1">
                                                <i class="fa fa-barcode"/>
                                                请扫描序列号
                                            </span>
                                        </t>
                                        <!-- Non-tracked components keep demand/custom actions and gain +1. -->
                                        <t t-if="comp.tracking === 'none'">
                                            <button t-if="state.barcode_mrp_lot_scan_policy === 'optional'"
                                                    type="button"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Add quantity"
                                                    t-on-click.stop="() => this.onAddComponentQuantity(comp.id)">
                                                +1
                                            </button>
                                            <t t-if="!comp.picked">
                                                <t t-if="state.editingQtyMoveId === comp.id">
                                                    <input
                                                        type="number"
                                                        min="0"
                                                        step="any"
                                                        class="form-control form-control-sm"
                                                        style="width: 6rem;"
                                                        t-att-value="state.draftQty || comp.total_demand"
                                                        t-on-input="(ev) => this.onDraftQtyInput(ev)"
                                                        t-on-keydown="(ev) => this.onDraftQtyKeydown(ev, comp.id)"
                                                        t-on-click.stop=""
                                                    />
                                                    <button type="button"
                                                            class="btn btn-sm btn-success"
                                                            title="Confirm quantity"
                                                            t-on-click.stop="() => this.onConfirmComponentQty(comp.id)">
                                                        <i class="fa fa-check"/>
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary"
                                                            title="Cancel"
                                                            t-on-click.stop="() => this.onCancelComponentQty()">
                                                        <i class="fa fa-times"/>
                                                    </button>
                                                </t>
                                                <t t-else="">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Consume BOM demand quantity"
                                                            t-on-click.stop="() => this.onConsumeByDemand(comp.id)">
                                                        消耗
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary"
                                                            title="Edit quantity to consume"
                                                            t-on-click.stop="() => this.onEditComponentQty(comp.id)">
                                                        <i class="fa fa-pencil"/>
                                                    </button>
                                                </t>
                                            </t>
                                            <button t-if="comp.picked"
                                                    type="button"
                                                    class="btn btn-sm btn-outline-warning"
                                                    title="Reset consumed quantity"
                                                    t-on-click.stop="() => this.onResetComponentMove(comp.id)">
                                                重置
                                            </button>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                            <tr t-if="state.expandedComponentId === comp.id">
                                <td colspan="2" class="ps-4 py-1 bg-white">
                                    <t t-foreach="comp.lots" t-as="sn" t-key="sn.key">
                                        <div class="d-flex align-items-center flex-wrap gap-2 small text-muted">
                                            <i class="fa fa-circle-o"/>
                                            <span t-att-class="'text-break' + (state.recentComponentLotKey === comp.id + ':' + sn.key ? ' badge bg-info o_mrp_scan_recent' : '')"
                                                  t-att-data-scan-lot="comp.id + ':' + sn.key"
                                                  style="min-width: 0;">
                                                <t t-out="sn.name" />
                                            </span>
                                            <strong t-if="sn.picked">× <t t-out="sn.picked_quantity" /></strong>
                                            <t t-else="">
                                                <span class="small opacity-75">待消耗</span>
                                                <strong>× <t t-out="sn.reserved_quantity" /></strong>
                                            </t>
                                            <button t-if="sn.picked"
                                                    type="button"
                                                    class="btn btn-sm btn-link text-danger p-0 flex-shrink-0"
                                                    t-att-title="'Remove ' + sn.name"
                                                    t-on-click.stop="() => this.onRemoveComponentLot(comp.id, sn.id)">
                                                <i class="fa fa-trash"/>
                                            </button>
                                            <t t-if="!sn.picked &amp;&amp; state.barcode_mrp_lot_scan_policy === 'optional'">
                                                <button t-if="comp.tracking === 'serial'"
                                                        type="button"
                                                        class="btn btn-sm btn-outline-success p-0 px-1"
                                                        title="Consume reserved lot"
                                                        t-on-click.stop="() => this.onConsumeReservedLot(comp.id, sn.id)">
                                                    <i class="fa fa-check"/>
                                                </button>
                                                <t t-else="">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-success p-0 px-1"
                                                            title="Consume reserved lot"
                                                            t-on-click.stop="() => this.onConsumeReservedLot(comp.id, sn.id)">
                                                        +1
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary p-0 px-1"
                                                            title="Edit quantity"
                                                            t-on-click.stop="() => this.onEditReservedLotQty(comp.id, sn.key)">
                                                        <i class="fa fa-pencil"/>
                                                    </button>
                                                </t>
                                            </t>
                                            <div t-if="!sn.picked &amp;&amp; comp.tracking !== 'serial' &amp;&amp; state.editingReservedLotKey === comp.id + ':' + sn.key"
                                                 class="d-flex align-items-center gap-1 border rounded p-2 bg-white text-dark w-100"
                                                 t-on-click.stop="">
                                                <input type="number"
                                                       min="0"
                                                       step="any"
                                                       class="form-control form-control-sm"
                                                       style="width: 6rem;"
                                                       t-att-value="state.draftReservedLotQty"
                                                       t-on-input="(ev) => this.onDraftReservedLotQtyInput(ev)"
                                                       t-on-keydown="(ev) => this.onDraftReservedLotQtyKeydown(ev, comp.id, sn.id)"/>
                                                <button type="button"
                                                        class="btn btn-sm btn-success"
                                                        title="Confirm quantity"
                                                        t-on-click.stop="() => this.onConfirmReservedLotQty(comp.id, sn.id)">
                                                    <i class="fa fa-check"/>
                                                </button>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        title="Cancel"
                                                        t-on-click.stop="() => this.onCancelReservedLotQty()">
                                                    <i class="fa fa-times"/>
                                                </button>
                                            </div>
                                        </div>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Action buttons (fixed at bottom for shop-floor scanning) -->
            <div class="o_mrp_scan_actions p-3 border-top d-flex gap-2 flex-wrap justify-content-between">
                <button
                    type="button"
                    class="btn btn-secondary btn-lg o_mrp_scan_back"
                    t-on-click="onBack"
                >Back</button>

                <div class="d-flex gap-2 flex-wrap">
                    <button
                        t-if="state.visible_switch_selector"
                        type="button"
                        class="btn btn-warning btn-lg o_mrp_scan_candidates"
                        t-on-click="onViewCandidates"
                    >View candidate MOs</button>

                    <button
                        t-if="canApplyLot"
                        type="button"
                        class="btn btn-primary btn-lg o_mrp_scan_apply_lot"
                        t-on-click="onApplyLot"
                    >Apply Lot</button>

                    <button
                        t-if="canConfirm"
                        type="button"
                        class="btn btn-primary btn-lg o_mrp_scan_confirm"
                        t-on-click="onConfirm"
                    >Confirm</button>

                    <button
                        t-if="state.visible_force_done"
                        type="button"
                        class="btn btn-warning btn-lg o_mrp_scan_force_done"
                        t-on-click="onForceDone"
                    >Force Consume</button>

                    <button
                        t-if="canFinish"
                        type="button"
                        class="btn btn-success btn-lg o_mrp_scan_finish"
                        t-on-click="onFinishProduction"
                    >Finish Production</button>
                </div>
            </div>
        </div>
    </t>
</templates>
