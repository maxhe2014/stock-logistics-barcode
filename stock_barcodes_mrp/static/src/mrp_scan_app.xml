  Template for the MrpScanApp client action (OWL).
  Responsive card-stack layout, design source:
  /home/max/下载/html-设计文件 (4)/html

  Structure:
    - top bar (open MO + MO name + produced qty)
    - scan row (back + input + camera)
    - hint bar (status + active scan target)
    - finished-product card (section 产品)
    - component cards (section 组件), lot/serial rows per card
    - footer action buttons

  JS hooks kept: .o_mrp_scan_input, .o_mrp_scan_finished_sn,
  [data-scan-row], [data-scan-lot].
-->
<templates id="template" xml:space="preserve">
    <t t-name="stock_barcodes_mrp.MrpScanApp">
        <div class="o_mrp_scan_app d-flex flex-column h-100">

            <!-- Top bar: open MO + name + produced qty (+ finished-lot escape) -->
            <div class="o_scan_topbar o_mrp_scan_mo_info" t-if="state.production_id">
                <button type="button" class="o_scan_src_btn" t-on-click="onOpenProduction" title="查看生产单">
                    <img class="o_scan_src_icon" src="/stock_barcodes_mrp/static/src/img/icon_doc.svg" alt=""/>
                </button>
                <div class="o_scan_doc_wrap">
                    <div class="o_scan_doc o_mrp_scan_doc_name"><t t-out="state.production_name" /></div>
                    <div class="o_scan_doc_progress">
                        生产数量：<t t-out="state.finished_qty_producing" /> / <t t-out="state.production_product_qty" />
                    </div>
                </div>
                <CogMenu t-if="state.production_id" t-props="cogMenuProps"/>
            </div>

            <!-- Scan row: back + input(with barcode icon) + camera -->
            <div class="o_scan_scanrow">
                <button
                    type="button"
                    class="o_scan_key o_mrp_scan_back"
                    t-on-click="onBack"
                    title="返回">
                    <img class="o_scan_back_icon" src="/stock_barcodes_mrp/static/src/img/icon_back.svg" alt=""/>
                </button>
                <div class="o_scan_input_wrap">
                    <img class="o_scan_barcode_icon" src="/stock_barcodes_mrp/static/src/img/icon_barcode.svg" alt=""/>
                    <input
                        type="text"
                        class="o_mrp_scan_input"
                        placeholder="扫码或输入条码..."
                        t-att-disabled="isScanDisabled ? 'disabled' : ''"
                        t-on-keydown="onManualScanEnter"
                    />
                </div>
                <button
                    type="button"
                    class="o_scan_key o_mrp_scan_camera"
                    t-att-disabled="isScanDisabled ? 'disabled' : ''"
                    t-on-click="onCameraScan"
                    aria-label="扫码"
                    title="扫码">
                    <img class="o_scan_camera_icon" src="/stock_barcodes_mrp/static/src/img/icon_camera.svg" alt=""/>
                </button>
            </div>

            <!-- Hint bar: status message + active scan target -->
            <div t-if="state.message || state.active_move_product_name"
                 t-att-class="'o_scan_hintbar ' + (state.message ? alertClass : 'alert-info')">
                <t t-if="state.message"><t t-out="state.message" /></t>
                <t t-if="state.message and state.active_move_product_name"> · </t>
                <span class="o_scan_hint_active" t-if="state.active_move_product_name">
                    正在扫描：<t t-out="state.active_move_product_name" />
                </span>
            </div>

            <!-- Candidate MO selector overlay -->
            <div t-if="state.visible_switch_selector"
                 class="o_mrp_scan_selector p-3 border rounded">
                <div class="fw-bold mb-2">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    多个生产单匹配，请选择：
                </div>
                <button type="button"
                        class="o_scan_key o_scan_key_warn o_mrp_scan_candidates"
                        t-on-click="onViewCandidates">
                    查看候选生产单
                </button>
            </div>

            <!-- Scrollable body -->
            <div class="o_mrp_scan_components">
                <div t-if="!state.production_id" class="o_scan_empty">
                    扫描生产单号或成品序列号开始
                </div>

                <!-- ============ 产品：finished product card ============ -->
                <t t-if="state.production_id">
                    <div class="o_scan_section_title">产品</div>
                    <div class="o_scan_stack">
                        <!-- Clicking this card activates the "scan finished
                             SN" context (same as the removed escape button):
                             it drops any component selection so the next
                             barcode is matched against the finished SN. -->
                        <div t-att-class="'o_scan_card' + (canBackToFinishedLot ? ' is-selectable-card' : '')"
                             t-att-title="canBackToFinishedLot ? '点击回到扫描成品批次/序列号' : ''"
                             t-on-click="onSelectFinishedLot">
                            <div class="o_scan_card_head">
                                <div class="o_scan_text_block">
                                    <div class="o_scan_pmeta_loc"
                                         t-if="state.production_source_name or state.production_dest_name">
                                        <span t-if="state.production_source_name">从：<t t-out="state.production_source_name" /></span>
                                        <span t-if="state.production_dest_name">至：<t t-out="state.production_dest_name" /></span>
                                    </div>
                                    <div class="o_scan_pname"><t t-out="state.production_product_name" /></div>
                                    <div class="o_scan_pmeta">
                                        成品
                                        <t t-if="state.finished_product_tracking === 'lot'"> | 批号</t>
                                        <t t-elif="state.finished_product_tracking === 'serial'"> | 序列号</t>
                                        <t t-else=""> | 无追踪</t>
                                    </div>
                                </div>
                            </div>
                            <div class="o_scan_card_body is-plain">
                                <div class="o_mrp_scan_finished_sn o_scan_row is-plain"
                                     t-if="state.finished_lot_name">
                                    <span class="o_scan_row_label">批号/序列号：</span>
                                    <span class="o_scan_row_name">
                                        <t t-out="state.finished_lot_name" />
                                    </span>
                                    <button t-if="canCleanFinishedLot"
                                            type="button"
                                            class="o_scan_sq o_scan_sq_edit"
                                            title="清除成品批次/序列号"
                                            t-on-click.stop="onCleanFinishedLot">
                                        <img class="o_scan_icon_trash" src="/stock_barcodes_mrp/static/src/img/icon_trash.svg" alt=""/>
                                    </button>
                                </div>
                                <div class="o_scan_row is-plain" t-elif="state.finished_product_tracking !== 'none'">
                                    <span class="o_scan_row_label">批号/序列号：</span>
                                    <span class="o_scan_row_qty">尚未扫描</span>
                                </div>
                                <div class="o_scan_row is-plain" t-else="">
                                    <span class="o_scan_row_qty">非追踪成品，无需成品批次/序列号</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- ============ 组件：component cards ============ -->
                <div class="o_scan_section_title" t-if="state.components.length">组件</div>
                <div class="o_scan_stack" t-if="state.components.length">
                    <t t-foreach="state.components" t-as="comp" t-key="comp.id">
                        <div t-att-class="'o_scan_card' + (state.active_move_id === comp.id ? ' is-selected' : '')">

                            <!-- Card head: click selects the scan target -->
                            <div class="o_scan_card_head is-selectable"
                                 title="点击选中该组件后再扫码"
                                 t-on-click="() => this.onSelectMove(comp.id)">
                                <div class="o_scan_text_block">
                                    <div class="o_scan_pmeta_loc" t-if="comp.location_name">
                                        <span>从：<t t-out="comp.location_name" /></span>
                                        <span t-if="comp.location_dest_name">至：<t t-out="comp.location_dest_name" /></span>
                                    </div>
                                    <div class="o_scan_pname"><t t-out="comp.product_name" /></div>
                                    <div class="o_scan_pmeta">
                                        需求 <t t-out="comp.total_demand" />
                                        <t t-if="comp.tracking === 'lot'"> | 批次号</t>
                                        <t t-if="comp.tracking === 'serial'"> | 序列号</t>
                                    </div>
                                </div>
                                <div t-att-class="'o_scan_head_actions is-stacked' + (state.editingQtyMoveId === comp.id ? ' is-editing' : '')">
                                    <div class="o_scan_picked">
                                        <span class="o_scan_picked_lbl">已拣:</span>
                                        <span class="o_scan_picked_num"><t t-out="comp.quantity" /></span>
                                        <span class="o_scan_picked_uom" t-if="comp.uom_name"><t t-out="comp.uom_name" /></span>
                                    </div>
                                    <div class="o_scan_actions_row">
                                        <!-- Tracked: hand = select scan target.
                                             Untracked: edit qty / consume demand / reset. -->
                                        <button t-if="comp.tracking !== 'none'"
                                                type="button"
                                                t-att-class="'o_scan_sq o_scan_sq_hand' + (state.active_move_id === comp.id ? ' is-active' : '')"
                                                title="选中该组件"
                                                t-on-click.stop="() => this.onSelectMove(comp.id)">
                                            <img class="o_scan_icon_hand" src="/stock_barcodes_mrp/static/src/img/icon_hand.svg" alt=""/>
                                        </button>

                                        <t t-else="">
                                            <t t-if="state.editingQtyMoveId === comp.id">
                                                <span class="o_scan_qty_edit" t-on-click.stop="">
                                                    <input type="number"
                                                           min="0"
                                                           step="any"
                                                           t-att-value="state.draftQty"
                                                           t-on-input="(ev) => this.onDraftQtyInput(ev)"
                                                           t-on-keydown="(ev) => this.onDraftQtyKeydown(ev, comp.id)"/>
                                                    <button type="button"
                                                            class="o_scan_sq o_scan_sq_add"
                                                            title="确认数量"
                                                            t-on-click.stop="() => this.onConfirmComponentQty(comp.id)">
                                                        <i class="fa fa-check"/>
                                                    </button>
                                                    <button type="button"
                                                            class="o_scan_sq"
                                                            title="取消"
                                                            t-on-click.stop="() => this.onCancelComponentQty()">
                                                        <i class="fa fa-times"/>
                                                    </button>
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <button type="button"
                                                        class="o_scan_sq o_scan_sq_edit"
                                                        title="修改数量"
                                                        t-on-click.stop="() => this.onEditComponentQty(comp.id)">
                                                    <img class="o_scan_icon_pencil" src="/stock_barcodes_mrp/static/src/img/icon_pencil.svg" alt=""/>
                                                </button>
                                                <button t-if="!comp.picked and comp.to_consume > 0"
                                                        type="button"
                                                        class="o_scan_sq o_scan_sq_add"
                                                        t-att-title="'按 BOM 需求消耗 ' + comp.to_consume"
                                                        t-on-click.stop="() => this.onConsumeByDemand(comp.id)"
                                                >+<t t-out="comp.to_consume" /></button>
                                                <button t-if="comp.picked"
                                                        type="button"
                                                        class="o_scan_sq o_scan_sq_edit"
                                                        title="重置已消耗数量"
                                                        t-on-click.stop="() => this.onResetComponentMove(comp.id)">
                                                    <img class="o_scan_icon_trash" src="/stock_barcodes_mrp/static/src/img/icon_trash.svg" alt=""/>
                                                </button>
                                            </t>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- Fold bar: serial cards only -->
                            <button t-if="comp.tracking === 'serial'"
                                    type="button"
                                    class="o_scan_foldbar"
                                    t-att-title="this.isComponentCollapsed(comp.id) ? '展开序列号' : '收起序列号'"
                                    t-on-click="() => this.onToggleComponentFold(comp.id)">
                                <span class="o_scan_grip"/>
                            </button>

                            <!-- Lot / serial rows -->
                            <div t-if="comp.tracking !== 'none'" class="o_scan_card_body">
                                <!-- Collapsed serial: last scanned (or first) lot + total -->
                                <t t-if="comp.tracking === 'serial' and this.isComponentCollapsed(comp.id)">
                                    <t t-set="summary" t-value="this.getComponentFoldSummary(comp)" />
                                    <div t-if="summary"
                                         t-att-class="'o_scan_row is-serial is-collapsed-single' + (state.recentComponentLotKey and state.recentComponentLotKey.startsWith(comp.id + ':') ? ' is-scanned' : '')"
                                         t-att-data-scan-row="comp.id">
                                        <span class="o_scan_row_name"><t t-out="summary.name" /></span>
                                        <div class="o_scan_row_side">
                                            <span class="o_scan_row_qty">已拣: <t t-out="summary.total" /></span>
                                        </div>
                                    </div>
                                </t>

                                <t t-elif="comp.lots.length">
                                    <t t-foreach="comp.lots" t-as="lot" t-key="lot.key">
                                        <div t-att-class="'o_scan_row' + (comp.tracking === 'serial' ? ' is-serial' : '') + (state.recentComponentLotKey === comp.id + ':' + lot.key ? ' is-scanned' : '')"
                                             t-att-data-scan-row="comp.id"
                                             t-att-data-scan-lot="comp.id + ':' + lot.key">
                                            <span class="o_scan_row_name"><t t-out="lot.name" /></span>
                                            <div class="o_scan_row_side">
                                                <span class="o_scan_row_qty">已拣: <t t-out="lot.picked_quantity" /></span>
                                                <div class="o_scan_row_btns">
                                                    <!-- Picked: remove this very lot/SN.
                                                         Reserved: optional-policy actions. -->
                                                    <button t-if="lot.picked"
                                                            type="button"
                                                            class="o_scan_sq o_scan_sq_edit"
                                                            t-att-title="'移除 ' + lot.name"
                                                            t-on-click.stop="() => this.onRemoveComponentLot(comp.id, lot.id)">
                                                        <img class="o_scan_icon_trash" src="/stock_barcodes_mrp/static/src/img/icon_trash.svg" alt=""/>
                                                    </button>
                                                    <t t-elif="state.barcode_mrp_lot_scan_policy === 'optional'">
                                                        <button type="button"
                                                                class="o_scan_sq o_scan_sq_add"
                                                                title="消耗该预留批次/序列号"
                                                                t-on-click.stop="() => this.onConsumeReservedLot(comp.id, lot.id)">+1</button>
                                                        <button t-if="comp.tracking === 'lot'"
                                                                type="button"
                                                                class="o_scan_sq o_scan_sq_edit"
                                                                title="修改数量"
                                                                t-on-click.stop="() => this.onEditReservedLotQty(comp.id, lot.key)">
                                                            <img class="o_scan_icon_pencil" src="/stock_barcodes_mrp/static/src/img/icon_pencil.svg" alt=""/>
                                                        </button>
                                                    </t>
                                                </div>
                                            </div>

                                            <!-- Reserved lot qty edit (lot only) -->
                                            <div t-if="!lot.picked and comp.tracking !== 'serial' and state.editingReservedLotKey === comp.id + ':' + lot.key"
                                                 class="o_scan_lot_edit"
                                                 t-on-click.stop="">
                                                <div class="o_scan_lot_edit_line">
                                                    <input type="number"
                                                           min="0"
                                                           step="any"
                                                           t-att-value="state.draftReservedLotQty"
                                                           t-on-input="(ev) => this.onDraftReservedLotQtyInput(ev)"
                                                           t-on-keydown="(ev) => this.onDraftReservedLotQtyKeydown(ev, comp.id, lot.id)"/>
                                                    <button type="button"
                                                            class="o_scan_sq o_scan_sq_add"
                                                            title="确认数量"
                                                            t-on-click.stop="() => this.onConfirmReservedLotQty(comp.id, lot.id)">
                                                        <i class="fa fa-check"/>
                                                    </button>
                                                    <button type="button"
                                                            class="o_scan_sq"
                                                            title="取消"
                                                            t-on-click.stop="() => this.onCancelReservedLotQty()">
                                                        <i class="fa fa-times"/>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </t>

                                <t t-else="">
                                    <!-- No lot yet -->
                                    <div class="o_scan_row">
                                        <span class="o_scan_row_qty" t-if="comp.tracking === 'serial'">请扫描序列号</span>
                                        <span class="o_scan_row_qty" t-else="">请扫描批次号</span>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Footer actions -->
            <div class="o_scan_footer" t-if="state.production_id">
                <div class="o_scan_footer_actions">
                    <!-- Left: add an extra component (same style as the
                         picking app's "添加产品"). -->
                    <button type="button"
                            class="o_scan_key o_scan_key_add_component o_mrp_scan_add_component"
                            t-on-click="onAddComponent"><i class="fa fa-plus"/> 添加组件</button>

                    <div class="o_scan_footer_actions_right">
                        <button t-if="state.visible_switch_selector"
                                type="button"
                                class="o_scan_key o_scan_key_warn o_mrp_scan_candidates"
                                t-on-click="onViewCandidates">查看候选</button>

                        <button t-if="canApplyLot"
                                type="button"
                                class="o_scan_key o_mrp_scan_apply_lot"
                                t-on-click="onApplyLot">Apply Lot</button>

                        <button t-if="state.visible_force_done"
                                type="button"
                                class="o_scan_key o_scan_key_warn o_mrp_scan_force_done"
                                t-on-click="onForceDone">Force Consume</button>

                        <button t-if="canConfirm"
                                type="button"
                                class="o_scan_key o_scan_key_primary o_mrp_scan_confirm"
                                t-on-click="onConfirm">Confirm</button>

                        <button t-if="canFinish"
                                type="button"
                                class="o_scan_key o_scan_key_primary o_mrp_scan_finish"
                                t-on-click="onFinishProduction">Finish Production</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
